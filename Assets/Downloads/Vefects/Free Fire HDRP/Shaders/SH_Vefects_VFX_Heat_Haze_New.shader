				UNITY_INITIALIZE_VERTEX_OUTPUT_STEREO( o );

				float3 ase_positionWS = GetAbsolutePositionWS( TransformObjectToWorld( ( inputMesh.positionOS ).xyz ) );
				float2 texCoord185 = inputMesh.ase_texcoord3.xy * float2( 1,1 ) + float2( 0,0 );
				
